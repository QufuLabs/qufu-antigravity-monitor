<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QufuUsageWidget</AssemblyName>
    <RootNamespace>QufuUsageWidget</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Qufu Antigravity Monitor</Product>
    <AssemblyTitle>Qufu Antigravity Monitor</AssemblyTitle>
    <Description>Local model quota monitor for Google Antigravity 2.0 Desktop</Description>
    <Company>Qufu</Company>
    <ApplicationIcon>..\assets\qufu-usage-monitor.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
